<Window x:Class="LinkXRemoteHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="LinkX Remote Pro Host" Height="600" Width="900" Icon="AppIcon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#0D0D0D" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Border Background="{StaticResource BackgroundGradient}" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,15">
                    <materialDesign:PackIcon Kind="Connection" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                    <TextBlock Text="LinkX Remote Pro" FontSize="18" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <materialDesign:PackIcon Kind="WindowMinimize" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Click="Close_Click" ToolTip="Close to Tray">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Sidebar -->
                <Border Background="#20FFFFFF" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="SERVER STATUS" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="Red" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusText" Text="Offline" Foreground="White" FontSize="16"/>
                        </StackPanel>
                        
                        <Separator Margin="0,20" Background="#40FFFFFF"/>
                        
                        <TextBlock Text="IP Address:" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="IpAddressText" Text="Loading..." Foreground="White" FontSize="14" Margin="0,5,0,15"/>
                        
                        <TextBlock Text="Port:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="8080" Foreground="White" FontSize="14" Margin="0,5,0,15"/>
                        
                        <TextBlock Text="Security PIN:" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="PinText" Text="----" Foreground="{DynamicResource PrimaryHueLightBrush}" FontSize="18" FontWeight="Bold" Margin="0,5,0,15"/>
                        
                        <Button x:Name="ToggleServerBtn" Content="START SERVER" Margin="0,30,0,0" Click="ToggleServerBtn_Click"/>
                    </StackPanel>
                </Border>
                
                <!-- Main Dashboard Panel -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,15,0" Width="160">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="30" Height="30" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                <TextBlock Text="Controller" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock x:Name="ControllerStatusText" Text="Disconnected" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,15,0" Width="160">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="NetworkOutline" Width="30" Height="30" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Network Mode" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Text="Wi-Fi / LAN" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#20FFFFFF" CornerRadius="8" Padding="15" Width="160">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Pair (Scan QR)" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <Image x:Name="QrCodeImage" Width="70" Height="70" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Real-Time Logs" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogTextBox" TextWrapping="Wrap" Foreground="#A0A0A0" FontFamily="Consolas" FontSize="12" Text="[System] Initializing LinkX Remote Pro...&#x0a;"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
