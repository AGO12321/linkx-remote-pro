<Window x:Class="LinkXRemoteHost.UI.WebcamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Webcam" Height="300" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    <Border CornerRadius="10" Background="#99000000" BorderBrush="#55FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="#33000000" MouseDown="Window_MouseDown">
                <TextBlock Text="Android Webcam - PiP" Foreground="White" Margin="10,5" FontWeight="Bold"/>
                <Button Content="X" Width="30" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="White" BorderThickness="0" Click="CloseButton_Click"/>
            </Grid>

            <Image x:Name="WebcamImage" Grid.Row="1" Stretch="Uniform"/>
        </Grid>
    </Border>
</Window>
